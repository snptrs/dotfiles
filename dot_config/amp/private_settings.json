{
  "amp.notifications.enabled": false,
  "amp.notifications.system.enabled": true,
  "amp.permissions": [
    {
      "tool": "Bash",
      "action": "ask",
      "matches": {
        "cmd": ["git push*", "git commit*", "rm*"]
      }
    }
  ],
  "amp.updates.mode": "auto",
  "amp.gauge": "cost",
  "amp.git.commit.ampThread.enabled": false,
  "amp.git.commit.coauthor.enabled": false
}
